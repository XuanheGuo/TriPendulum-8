<mujoco model="tripendulum_8">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <joint damping="0.02" frictionloss="0.001" armature="0.001"/>
    <geom rgba="0.2 0.4 0.8 1" contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light name="top" pos="0 0 4"/>
    <camera name="fixed" pos="0 -10 2.8" xyaxes="1 0 0 0 0.28 0.96"/>
    <geom name="track" type="box" pos="0 0 -0.08" size="4.8 0.03 0.02" rgba="0.25 0.25 0.25 1" contype="0" conaffinity="0"/>

    <body name="cart" pos="0 0 0">
      <joint name="cart_slider" type="slide" axis="1 0 0" limited="false" damping="0.1"/>
      <geom name="cart_geom" type="box" size="0.16 0.08 0.08" rgba="0.8 0.2 0.2 1" contype="0" conaffinity="0"/>

      <body name="link1" pos="0 0 -0.08">
        <joint name="hinge1" type="hinge" axis="0 1 0" limited="false" damping="0.01"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0 0 -0.55" size="0.025" rgba="0.1 0.45 0.9 1" contype="0" conaffinity="0"/>
        <body name="link2" pos="0 0 -0.55">
          <joint name="hinge2" type="hinge" axis="0 1 0" limited="false" damping="0.01"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0 0 -0.45" size="0.022" rgba="0.1 0.75 0.35 1" contype="0" conaffinity="0"/>
          <body name="link3" pos="0 0 -0.45">
            <joint name="hinge3" type="hinge" axis="0 1 0" limited="false" damping="0.01"/>
            <geom name="link3_geom" type="capsule" fromto="0 0 0 0 0 -0.35" size="0.02" rgba="0.9 0.65 0.1 1" contype="0" conaffinity="0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="cart_force" joint="cart_slider" gear="1" ctrllimited="true" ctrlrange="-40 40"/>
  </actuator>
</mujoco>
